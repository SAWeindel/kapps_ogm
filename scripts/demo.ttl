@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix demo:   <http://demo.org/TransferUnit#> .

# ── Ontology declaration ────────────────────────────────────────────────────

demo: rdf:type owl:Ontology ;
    rdfs:label "TransferUnit demo ontology" .

# ── Classes ─────────────────────────────────────────────────────────────────

demo:TransferUnit rdf:type owl:Class ;
    rdfs:label "Transfer Unit" .

demo:ConveyorBelt rdf:type owl:Class ;
    rdfs:label "Conveyor Belt" .

demo:ConveyorPosition rdf:type owl:Class ;
    rdfs:label "Conveyor Position" .

# ── Object properties ────────────────────────────────────────────────────────

demo:hasConveyorBelt rdf:type owl:ObjectProperty ;
    rdfs:label "has conveyor belt" ;
    rdfs:domain demo:TransferUnit ;
    rdfs:range  demo:ConveyorBelt .

demo:hasConveyorPosition rdf:type owl:ObjectProperty ;
    rdfs:label "has conveyor position" ;
    rdfs:domain demo:ConveyorBelt ;
    rdfs:range  demo:ConveyorPosition .

# ── Datatype properties ──────────────────────────────────────────────────────

demo:isWorking rdf:type owl:DatatypeProperty ;
    rdfs:label "is working" ;
    rdfs:domain demo:ConveyorBelt ;
    rdfs:range  xsd:boolean .

demo:hasUnit rdf:type owl:DatatypeProperty ;
    rdfs:label "has unit" ;
    rdfs:domain demo:ConveyorPosition ;
    rdfs:range  xsd:string .

demo:hasValue rdf:type owl:DatatypeProperty ;
    rdfs:label "has value" ;
    rdfs:domain demo:ConveyorPosition ;
    rdfs:range  xsd:double .
